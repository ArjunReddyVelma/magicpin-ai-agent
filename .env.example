APP_ENV=development
APP_NAME=Magicpin AI Agent
API_V1_STR=/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/magicpin_ai_agent

# LLM Configuration
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Security & Sessions
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TTL_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_NAME=mp_session

# Observability
LOG_LEVEL=INFO
