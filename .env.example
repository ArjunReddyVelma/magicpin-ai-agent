APP_ENV=development
APP_NAME=Magicpin AI Agent
API_V1_STR=/v1
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/magicpin_ai_agent

# LLM Configuration
# LLM_PROVIDER options: 'groq' (requires LLM_API_KEY) or 'mock' (offline development/testing)
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Security, Origins & Frontend API Configuration
# In production, set FRONTEND_ORIGIN to your frontend URL (e.g. https://magicpin-frontend.onrender.com).
# Bare hostnames (magicpin-frontend.onrender.com) are automatically normalized to https://.
# Comma-separated lists are supported for multi-domain setups.
FRONTEND_ORIGIN=http://localhost:5173

# Frontend client API base URL (optional build-time variable).
# When unset or empty, the frontend defaults to '/v1', routing through local Vite proxy or Render rewrite rules.
# If deploying frontend separately from backend, set to full URL: https://magicpin-backend.onrender.com/v1
# VITE_API_BASE_URL=https://magicpin-backend.onrender.com/v1

SESSION_TTL_MINUTES=10080
CSRF_SECRET=change-this-in-production-to-a-secure-csrf-secret-key-32-chars
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_NAME=mp_session

# Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900

# Observability
LOG_LEVEL=INFO

# WhatsApp Cloud API (never commit real secrets)
# Mode: 'live' (default, connects to Meta Graph API) or 'mock' (offline sandbox simulation)
WHATSAPP_MODE=live
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-webhook-verification-token
WHATSAPP_APP_SECRET=your-meta-app-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHATSAPP_ENCRYPTION_KEY=generate-a-fernet-key-before-use
WHATSAPP_GRAPH_API_VERSION=v22.0
